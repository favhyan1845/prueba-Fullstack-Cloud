# ===== Server =====
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:4200

# ===== AI Provider =====
# Available: mock | openai | gemini | ollama | anthropic | bedrock
AI_PROVIDER=mock
AI_MODEL=gpt-4o-mini

# ===== Provider credentials (leave empty for mock) =====
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
AWS_REGION=us-east-1
OLLAMA_BASE_URL=http://localhost:11434

# ===== Repository Fetcher =====
# Where to download temporary Git/ZIP repositories
WORK_DIR=./tmp/work
MAX_REPO_SIZE_MB=25